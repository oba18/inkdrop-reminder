{
  "name": "reminder",
  "version": "0.5.2",
  "description": "Due dates and desktop reminders for tasks, with a TickTick-style date picker",
  "keywords": [
    "inkdrop",
    "reminder",
    "task",
    "todo",
    "notification"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/oba18/inkdrop-reminder"
  },
  "bugs": {
