  },
  "main": "./lib/index.js",
  "files": [
    "lib",
    "keymaps",
    "styles"
  ],
  "scripts": {
    "dev": "tsdown --watch",
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build"
  },
  "devDependencies": {
    "@codemirror/state": "^6.7.6",
